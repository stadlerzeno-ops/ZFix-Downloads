<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ch.zfix.fmradio" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="29"/>

    <!-- FM tuner of the NWD radio service (com.nwd.radio.service) -->
    <uses-permission android:name="android.permission.ACCESS_FM_RADIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <queries>
        <package android:name="com.nwd.radio.service"/>
        <intent>
            <action android:name="com.nwd.radio.service.ACTION_RADIO_SERVICE"/>
        </intent>
    </queries>

    <application
        android:label="ZFix Radio"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name="ch.zfix.fmradio.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
